{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2021",
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./",
        "incremental": true,
        "skipLibCheck": true,
        "strict": false
    },
    "include": [
        "src/**/*"
    ]
}